<?xml version="1.0" encoding="utf-8"?>
<!-- The gateway address is HTTPS, and this file adds nothing to a release
     build: the trust anchors below apply only while android:debuggable is
     true, so a developer can point the Coach at a gateway whose certificate
     the OS would not trust, and a release build keeps the system anchors.
     (ADR-0016, ADR-0020) -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/gateway_ca" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
